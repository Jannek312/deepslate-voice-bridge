# Copy to firmware/secrets.yaml and fill in. secrets.yaml is gitignored.
wifi_ssid: "YourWifi"
wifi_password: "changeme"
# OTA password for future over-the-air updates (pick any strong value once).
ota_password: "changeme"
# ESPHome native API encryption key: 32 random bytes, base64.
# Generate with:  openssl rand -base64 32
api_key: "changeme"
